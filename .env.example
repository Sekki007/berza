APP_ENV=production
APP_DEBUG=false

# Glavni javni URL sajta (SEO canonical, sitemap, Open Graph)
APP_URL=https://kupitelefon.rs

# Aplikacija trenutno radi na JSON (data/). MySQL je spreman za import / budući prelazak.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=berza
DB_USER=berza_user
DB_PASS=promeni_lozinku

# Kasnije: json | mysql
STORAGE_DRIVER=json

# SMSGate (samo +381 mobilni; OTP za registraciju i reset lozinke)
SMS_ENABLED=true
SMS_GATEWAY_URL=https://sandzak.net/sms/api/3rdparty/v1/messages
SMS_GATEWAY_USER=
SMS_GATEWAY_PASS=

# Zoho Mail SMTP (notifikacije: poruke, istek oglasa, verify…)
SMTP_ENABLED=true
SMTP_HOST=smtp.zoho.eu
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USERNAME=podrska@kupitelefon.rs
SMTP_FROM_EMAIL=podrska@kupitelefon.rs
SMTP_FROM_NAME=KupiTelefon.rs
ZOHO_SMTP_PASSWORD=
