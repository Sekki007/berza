APP_ENV=production
APP_DEBUG=false

# Glavni javni URL sajta (SEO canonical, sitemap, Open Graph)
APP_URL=https://kupitelefon.rs

# Aplikacija trenutno radi na JSON (data/). MySQL je spreman za import / budući prelazak.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=berza
DB_USER=berza_user
DB_PASS=promeni_lozinku

# Kasnije: json | mysql
STORAGE_DRIVER=json

# SMSGate (samo +381 mobilni; OTP za registraciju i reset lozinke)
SMS_ENABLED=true
SMS_GATEWAY_URL=https://sandzak.net/sms/api/3rdparty/v1/messages
SMS_GATEWAY_USER=
SMS_GATEWAY_PASS=

# Zoho Mail SMTP (notifikacije: poruke, istek oglasa, verify…)
SMTP_ENABLED=true
SMTP_HOST=smtp.zoho.eu
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USERNAME=podrska@kupitelefon.rs
SMTP_FROM_EMAIL=podrska@kupitelefon.rs
SMTP_FROM_NAME=KupiTelefon.rs
ZOHO_SMTP_PASSWORD=

# Telegram bot notifikacije (opciono)
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_LINK_TTL_MIN=15
TELEGRAM_LINK_CODE_LEN=7

# FCM push (Android app) — Firebase Cloud Messaging HTTP v1
# 1) Firebase Console → Create project → Cloud Messaging
# 2) Project settings → Service accounts → Generate new private key
# 3) Android app package: rs.kupitelefon.app → download google-services.json
#    stavi u: mobile/android/app/google-services.json
FCM_ENABLED=false
FCM_PROJECT_ID=
# Putanja do JSON fajla ILI ceo JSON u jednom redu:
FCM_SERVICE_ACCOUNT_JSON=

# Google Analytics 4 Data API (admin statistika poseta)
# 1) Cloud Console → Enable "Google Analytics Data API"
# 2) Service account → Viewer u GA4 Property access management
# 3) Admin → Podešavanja → GA4 Property ID
# Ako je prazno, koristi se FCM_SERVICE_ACCOUNT_JSON (isti nalog mora imati Viewer u GA4).
GA_SERVICE_ACCOUNT_JSON=

# IMEI provera
# Osnovna: besplatan TAC endpoint (free_with_key) — za sve posetioce.
# Proširena: DHRU (blacklist, FMI, iCloud) — samo ulogovani, 5/dan.
IMEI_CHECK_ENABLED=false
IMEI_CHECK_API_KEY=
IMEI_CHECK_FREE_URL=https://alpha.imeicheck.com/api/free_with_key/modelBrandName

# DHRU proširena provera (odvojen access key od free TAC ključa)
IMEI_CHECK_URL=https://dhru.checkimei.com
IMEI_CHECK_USERNAME=
IMEI_CHECK_DHRU_API_KEY=
IMEI_CHECK_SERVICE_BLACKLIST=5
IMEI_CHECK_SERVICE_FMI=1
IMEI_CHECK_SERVICE_ICLOUD=4
