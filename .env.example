APP_ENV=production
APP_DEBUG=false

# Aplikacija trenutno radi na JSON (data/). MySQL je spreman za import / budući prelazak.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=berza
DB_USER=berza_user
DB_PASS=promeni_lozinku

# Kasnije: json | mysql
STORAGE_DRIVER=json

# SMSGate (samo +381 mobilni; OTP za registraciju i reset lozinke)
SMS_ENABLED=true
SMS_GATEWAY_URL=https://sandzak.net/sms/api/3rdparty/v1/messages
SMS_GATEWAY_USER=
SMS_GATEWAY_PASS=

# TextMeBot WhatsApp (obaveštenja: poruke, istek oglasa, alerti) — opt-in u nalogu
WHATSAPP_ENABLED=false
WHATSAPP_API_KEY=
# WHATSAPP_API_URL=https://api.textmebot.com/send.php
# WHATSAPP_MIN_GAP_SEC=8
